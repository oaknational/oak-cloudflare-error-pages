{
  "name": "oak-cloudflare-error-pages",
  "private": true,
  "version": "1.0.0",
  "description": "Static Cloudflare Error Pages",
  "repository": "git@github.com:oaknational/oak-cloudflare-error-pages.git",
  "license": "MIT",
  "scripts": {
    "check:pages": "node scripts/check-pages.mjs",
    "lint:html": "html-validate \"docs/*.html\"",
    "test:a11y": "node scripts/a11y.mjs",
    "smoke": "node scripts/smoke-pages.mjs",
    "test": "npm run build -- --check && npm run check:pages && npm run lint:html && npm run test:a11y",
    "build": "node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "html-validate": "^11.17.0",
    "playwright": "^1.64.1"
  }
}
